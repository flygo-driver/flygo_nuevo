rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    /* ========= Helpers ========= */
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    // Imagen, PDF u octet-stream (putData Android sin MIME explícito).
    function esImagenOPdfSubida() {
      return request.resource.contentType.matches('image/.*')
        || request.resource.contentType == 'application/pdf'
        || request.resource.contentType == 'application/octet-stream';
    }

    /* ========= AVATARES =========
       Ruta: perfiles/{uid}/avatar_*.jpg
       Lectura: cualquiera autenticado
       Escritura: solo el dueño, máx 5MB, solo imagen
    */
    match /perfiles/{uid}/{fileName} {
      allow read: if signedIn();
      allow write: if isOwner(uid)
                   && request.resource != null
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    /* ========= DOCUMENTOS TAXISTA =========
       Ruta app: documentos_taxista/{uid}/{tipo}_{timestamp}.jpg
       Solo el taxista autenticado escribe en SU carpeta (uid == auth.uid).
    */
    match /documentos_taxista/{uid}/{fileName} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid)
                   && request.resource != null
                   && request.resource.size > 0
                   && request.resource.size < 10 * 1024 * 1024
                   && esImagenOPdfSubida();
    }

    /* ========= RUTAS NUEVAS USADAS POR LA APP =========
       users/{uid}/documentos/...  y  taxistas/{uid}/documentos/...
       Lectura: autenticados
       Escritura: dueño, máx 10MB, imagen o PDF
    */
    match /users/{uid}/documentos/{allPaths=**} {
      allow read: if signedIn();
      allow write: if isOwner(uid)
                   && request.resource != null
                   && request.resource.size < 10 * 1024 * 1024
                   && (
                        request.resource.contentType.matches('image/.*') ||
                        request.resource.contentType == 'application/pdf'
                      );
    }

    match /taxistas/{uid}/documentos/{allPaths=**} {
      allow read: if signedIn();
      allow write: if isOwner(uid)
                   && request.resource != null
                   && request.resource.size < 10 * 1024 * 1024
                   && (
                        request.resource.contentType.matches('image/.*') ||
                        request.resource.contentType == 'application/pdf'
                      );
    }

    /* ========= COMPROBANTES DE DEPÓSITO (POOLS) =========
       Ruta: comprobantes/{uid}/{reservaId}/{fileId}
       Lectura/Escritura: solo el dueño, máx 5MB, imagen o PDF
       (El admin puede leer con Admin SDK)
    */
    match /comprobantes/{uid}/{reservaId}/{fileId} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid)
                   && request.resource != null
                   && request.resource.size < 5 * 1024 * 1024
                   && (
                        request.resource.contentType.matches('image/.*') ||
                        request.resource.contentType == 'application/pdf'
                      );
    }

    /* ========= Firmas de recibos (FirmarPago) ========= */
    match /firmas/{fileName} {
      allow read: if signedIn();
      allow write: if signedIn()
                   && request.resource != null
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType == 'image/png';
    }

    /* ========= Pools turismo: logos / banners (pools_taxista_crear) ========= */
    match /agencias/{uid}/{fileName} {
      allow read: if signedIn();
      allow write: if isOwner(uid)
                   && request.resource != null
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    match /viajes_pool/{uid}/{fileName} {
      allow read: if signedIn();
      allow write: if isOwner(uid)
                   && request.resource != null
                   && request.resource.size < 50 * 1024 * 1024
                   && (
                        request.resource.contentType.matches('image/.*') ||
                        request.resource.contentType.matches('video/.*')
                      );
    }

    /* ========= Organizador de giras (cédula / pasaporte) =========
       Ruta: organizadores_giras/{uid}/cedula_*.jpg
    */
    match /organizadores_giras/{uid}/{fileName} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid)
                   && request.resource != null
                   && request.resource.size > 0
                   && request.resource.size < 6 * 1024 * 1024
                   && esImagenOPdfSubida();
    }

    /* ========= Logo empresa corporativa (encargado web /empresas) =========
       Ruta: empresas_corporativas/{empresaId}/logo/logo_{ts}.jpg
    */
    function isAdminStorage() {
      return signedIn() &&
        firestore.exists(/databases/(default)/documents/usuarios/$(request.auth.uid)) &&
        (
          firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data.rol == 'admin' ||
          firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data.isAdmin == true
        );
    }

    function esEncargadoCorporativoStorage(empresaId) {
      return signedIn() &&
        firestore.exists(/databases/(default)/documents/empresas_corporativas/$(empresaId)) &&
        firestore.get(/databases/(default)/documents/empresas_corporativas/$(empresaId)).data.keys().hasAny(['encargadoUids']) &&
        request.auth.uid in firestore.get(/databases/(default)/documents/empresas_corporativas/$(empresaId)).data.encargadoUids;
    }

    match /empresas_corporativas/{empresaId}/logo/{fileName} {
      allow read: if signedIn();
      allow write: if (esEncargadoCorporativoStorage(empresaId) || isAdminStorage())
                   && request.resource != null
                   && request.resource.size > 0
                   && request.resource.size < 3 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    /* ========= REPORTES ADMIN EXPORTABLES =========
       Ruta: admin_reports/{adminUid}/{fileName}
       Acceso directo desde cliente: bloqueado (descarga via URL firmada temporal de Cloud Functions).
    */
    match /admin_reports/{adminUid}/{fileName} {
      allow read, write: if false;
    }

    /* ========= Bloqueo por defecto ========= */
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
