rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/usuarios/$(uid));
    }

    function myUserDoc() {
      return userDoc(request.auth.uid);
    }

    function myUserDocExists() {
      return isAuth() &&
        exists(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }

    function roleDoc(uid) {
      return get(/databases/$(database)/documents/roles/$(uid));
    }

    function roleFromRolesCollection(uid) {
      return exists(/databases/$(database)/documents/roles/$(uid)) &&
        roleDoc(uid).data.rol is string
        ? roleDoc(uid).data.rol
        : "";
    }

    function normalizedRole(raw) {
      return raw == "administrador" ? "admin" :
        raw == "driver" ? "taxista" :
        raw == "user" ? "cliente" :
        raw;
    }

    function rolUsuarioSesion() {
      let r = myRole();
      return r != ""
        ? normalizedRole(r)
        : normalizedRole(roleFromRolesCollection(request.auth.uid));
    }

    function myRole() {
      return myUserDocExists()
        ? (myUserDoc().data.rol is string ? myUserDoc().data.rol : "")
        : "";
    }

    /// Coincide con LoginAdmin / AdminGate / admin_dashboard (CF).
    function isAdmin() {
      return isAuth() && (
        normalizedRole(myRole()) == "admin" ||
        normalizedRole(roleFromRolesCollection(request.auth.uid)) == "admin" ||
        (myUserDocExists() && (
          myUserDoc().data.isAdmin == true ||
          myUserDoc().data.admin == true
        ))
      );
    }

    /// taxista o driver (misma convención que la app y Cloud Functions).
    /// Usa rolUsuarioSesion: usuarios.rol o fallback roles/{uid} (como getRole en CF).
    function esRolChoferEnSesion() {
      return isAuth() && rolUsuarioSesion() == "taxista";
    }

    function isTaxista() {
      return isAuth() && rolUsuarioSesion() == "taxista";
    }

    /// Chofer habilitado en el pool corporativo (lectura de logo/nombre empresa).
    function esChoferCorporativoAprobado() {
      return isTaxista() &&
        exists(/databases/$(database)/documents/choferes_corporativos/$(request.auth.uid));
    }

    /// PR2: sin escritura legacy en pagos_taxistas (solo lectura histórica).
    function pr2PagosTaxistasEscrituraDeshabilitada() {
      return exists(/databases/$(database)/documents/config/finance) &&
        get(/databases/$(database)/documents/config/finance).data.useLiquidacionesSemanales == true &&
        get(/databases/$(database)/documents/config/finance).data.escrituraPagosTaxistasLegacy == false;
    }

    function isCliente() {
      return isAuth() && rolUsuarioSesion() == "cliente";
    }

    function esEncargadoCorporativo(empId) {
      return isAuth() &&
        exists(/databases/$(database)/documents/empresas_corporativas/$(empId)) &&
        get(/databases/$(database)/documents/empresas_corporativas/$(empId)).data.keys().hasAny(['encargadoUids']) &&
        get(/databases/$(database)/documents/empresas_corporativas/$(empId)).data.encargadoUids is list &&
        request.auth.uid in get(/databases/$(database)/documents/empresas_corporativas/$(empId)).data.encargadoUids;
    }

    /// Lectura de doc empresa (get/list): usa resource para que el query
    /// arrayContains:encargadoUids no dé permission-denied.
    function esEncargadoCorporativoResource() {
      return isAuth() &&
        resource.data.keys().hasAny(['encargadoUids']) &&
        resource.data.encargadoUids is list &&
        request.auth.uid in resource.data.encargadoUids;
    }

    /// Crear viaje pasajero: dueño autenticado (no admin). Cuentas conductor también
    /// pueden pedir viaje en la app pasajero (Play unificado / mismo uid).
    function puedeCrearViajeComoCliente() {
      return isAuth() &&
        request.resource.data.uidCliente == request.auth.uid &&
        request.resource.data.clienteId == request.auth.uid &&
        request.resource.data.uidTaxista == "" &&
        request.resource.data.taxistaId == "" &&
        rolUsuarioSesion() != "admin";
    }

    /// Pedido = solo cliente publica; Oferta «Voy para» = solo chofer publica.
    function bolaPuebloCreateRolTipoCoherente() {
      return (request.resource.data.tipo == "pedido" &&
          rolUsuarioSesion() == "cliente" &&
          request.resource.data.createdByRol == "cliente") ||
        (request.resource.data.tipo == "oferta" &&
          esRolChoferEnSesion() &&
          (request.resource.data.createdByRol == "taxista" ||
            request.resource.data.createdByRol == "driver"));
    }

    /// Cierre contable y estado finalizada solo vía Admin SDK (Cloud Function), no desde el cliente.
    function bolaCierreFinancieroSoloServidor() {
      return (request.resource.data.estado == "finalizada" &&
          resource.data.estado != "finalizada") ||
        (request.resource.data.comisionAplicada == true &&
          (!resource.data.keys().hasAny(["comisionAplicada"]) ||
            resource.data.comisionAplicada != true));
    }

    /// Acuerdo (abierta → acordada + montos/PIN) solo Cloud Functions (Admin SDK).
    function bolaTransicionAcuerdoSoloServidor() {
      let pasaAAcordada = request.resource.data.estado == "acordada" &&
        resource.data.estado == "abierta";
      let tocaCamposAcuerdo = request.resource.data.diff(resource.data).changedKeys()
        .hasAny([
          "ofertaAceptadaId", "montoAcordadoRd", "comisionPct", "comisionRd",
          "gananciaNetaChoferRd", "acordadaEn", "codigoVerificacionBola",
          "codigoGeneradoEn"
        ]);
      return !(pasaAAcordada || (resource.data.estado == "abierta" && tocaCamposAcuerdo));
    }

    function taxistaSinDeuda(uid) {
      return exists(/databases/$(database)/documents/usuarios/$(uid)) &&
        !(userDoc(uid).data.tienePagoPendiente == true);
    }

    function taxistaDocsEstadoDe(uid) {
      let u = userDoc(uid).data;
      let e = u.docsEstado is string ? u.docsEstado : "";
      return e != "" ? e : (u.estadoDocumentos is string ? u.estadoDocumentos : "pendiente");
    }

    /// Claim pool: registro + docs aprobados + contrato (paridad TaxistaEntry; no puedeRecibirViajes).
    function taxistaAptoParaClaimPool(uid) {
      let u = userDoc(uid).data;
      return u.registroTaxistaCompleto == true &&
        u.documentosCompletos == true &&
        taxistaDocsEstadoDe(uid) == "aprobado" &&
        u.contratoTaxistaAceptado == true &&
        !(u.bloqueado == true);
    }

    function esViajeCorporativoDocData() {
      return resource.data.corporativo == true ||
        resource.data.canalAsignacion == "corporativo_fijo" ||
        (resource.data.categoria is string &&
          resource.data.categoria == "corporativo") ||
        resource.data.recaudoDestino == "empresa_corporativa";
    }

    function esChoferCorporativoDelViaje() {
      return request.auth.uid == resource.data.uidTaxista ||
        request.auth.uid == resource.data.taxistaId ||
        request.auth.uid == resource.data.corporativoChoferPreferidoUid ||
        request.auth.uid == resource.data.corporativoChoferAsignadoUid;
    }

    /// Chofer corporativo en pantalla «Elige tu destino» (paradas, Maps, sin PIN).
    function esPatchRutaCorpInformativaChofer() {
      return esRolChoferEnSesion() &&
        esViajeCorporativoDocData() &&
        esChoferCorporativoDelViaje() &&
        viajeNoTocaCamposFinancierosProtegidos() &&
        changedOnly([
          "corporativoModoInformativo",
          "corporativoParadasHechas",
          "corporativoParadasAbiertas",
          "corporativoParadaActualIdx",
          "corporativoParadaAbiertaEn",
          "corporativoParadaActualizadaEn",
          "corporativoRecogidaAbierta",
          "corporativoRecogidaAbiertaEn",
          "corporativoLlegadaEmpresaEn",
          "multiparadaLegsTotal",
          "multiparadaLegCompletadas",
          "multiparadaCompleta",
          "clienteAbordo",
          "pickupConfirmadoEn",
          "estado",
          "extras",
          "updatedAt",
          "actualizadoEn"
        ]) &&
        request.resource.data.estado != "completado" &&
        request.resource.data.completado != true &&
        (
          !(request.resource.data.estado in ["en_curso", "encurso"]) ||
          resource.data.corporativoModoInformativo == true ||
          request.resource.data.corporativoModoInformativo == true
        );
    }

    function changedOnly(allowed) {
      return request.resource.data.diff(resource.data).changedKeys().hasOnly(allowed);
    }

    /// Auto-registro: rol operativo y sin flags de admin/aprobación en el primer write.
    function usuarioSelfCreateSeguro() {
      let d = request.resource.data;
      let rolOk = !("rol" in d) ||
        (d.rol is string &&
          (d.rol == "" || d.rol in ["cliente", "taxista"]));
      let sinAdmin = !("isAdmin" in d) || d.isAdmin == false;
      let sinAdminFlag = !("admin" in d) || d.admin == false;
      let sinAprobacionDocs =
        (!("docsEstado" in d) || d.docsEstado in ["pendiente", "en_revision", ""]) &&
        (!("estadoDocumentos" in d) || d.estadoDocumentos in ["pendiente", "en_revision", ""]);
      let sinRecibirViajes = !("puedeRecibirViajes" in d) || d.puedeRecibirViajes == false;
      return rolOk && sinAdmin && sinAdminFlag && sinAprobacionDocs && sinRecibirViajes;
    }

    // Campos de cierre financiero / pago que no deben ser mutables por cliente-taxista.
    function viajeCamposFinancierosProtegidos() {
      return [
        "payment",
        "pagoRegistrado",
        "transferenciaConfirmada",
        "pagoATaxistaPendiente",
        "pagoTaxistaPendiente",
        "liquidado",
        "pagoDetalle",
        "settlement",
        "precio_cents",
        "comision_cents",
        "ganancia_cents",
        "precio",
        "total",
        "comision",
        "comisionFlygo",
        "gananciaTaxista",
        "comisionCalculada",
        "comisionCalculadaEn",
        "estadoPago",
        "confirmacionTransferencia",
        "referenciaRecaudo",
        "recaudoDestino",
        "qrRecaudoPayload",
        "qrRecaudoTipo",
        "qrRecaudoVersion",
        "qrRecaudoGeneradoEn",
        "qrRecaudoEstado",
        "pagoAzulId",
        "conciliacionId",
        "conciliacionEstado",
        "movimientoBancoEntradaId",
        "elegibleLiquidacionSemanal"
      ];
    }

    // En CREATE cliente permitimos tarifa base (precio/precio_cents) y flags iniciales
    // de pago acordes con ViajesRepo.crearViajePendiente (estadoPago=pendiente, etc.).
    // No se permiten liquidación, comisión calculada ni objetos payment/settlement.
    function viajeCamposFinancierosProtegidosEnCreateCliente() {
      return [
        "payment",
        "pagoRegistrado",
        "liquidado",
        "pagoDetalle",
        "settlement",
        "comision_cents",
        "ganancia_cents",
        "comision",
        "comisionFlygo",
        "gananciaTaxista",
        "comisionCalculada",
        "comisionCalculadaEn",
        "confirmacionTransferencia"
      ];
    }

    /// Solo valores iniciales benignos; el backend/callables mutan estadoPago y transferencias.
    function viajeCreateClienteFlagsPagoInicialesOk() {
      return (!request.resource.data.keys().hasAny(["estadoPago"]) ||
          request.resource.data.estadoPago == "pendiente") &&
        (!request.resource.data.keys().hasAny(["transferenciaConfirmada"]) ||
          request.resource.data.transferenciaConfirmada == false) &&
        (!request.resource.data.keys().hasAny(["pagoATaxistaPendiente"]) ||
          request.resource.data.pagoATaxistaPendiente == false) &&
        (!request.resource.data.keys().hasAny(["pagoTaxistaPendiente"]) ||
          request.resource.data.pagoTaxistaPendiente == false);
    }

    function viajeNoTocaCamposFinancierosProtegidos() {
      return !request.resource.data.diff(resource.data).changedKeys()
        .hasAny(viajeCamposFinancierosProtegidos());
    }

    // Bola pueblo: cierre y comisión solo tras en_curso + código verificado (anti-fraude).
    function bolaCierreBaseOk() {
      return resource.data.estado == "en_curso" &&
        resource.data.codigoVerificado == true &&
        request.resource.data.confirmacionTaxistaFinal == true &&
        request.resource.data.confirmacionClienteFinal == true;
    }

    function bolaMarcandoFinalizada() {
      return request.resource.data.estado == "finalizada";
    }

    function bolaActivandoComisionPorPrimeraVez() {
      return request.resource.data.comisionAplicada == true &&
        (!resource.data.keys().hasAny(["comisionAplicada"]) ||
          resource.data.comisionAplicada != true);
    }

    function bolaFinalizacionPermitida() {
      return !bolaMarcandoFinalizada() || bolaCierreBaseOk();
    }

    function bolaComisionPermitida() {
      return !bolaActivandoComisionPorPrimeraVez() || (
        bolaCierreBaseOk() &&
        request.resource.data.estado == "finalizada"
      );
    }

    function bolaPickupCamposCambiados() {
      return request.resource.data.diff(resource.data).changedKeys()
        .hasAny(['pickupConfirmadoTaxista', 'pickupConfirmadoTaxistaEn']);
    }

    // Al aceptar oferta, el dueño (cliente o conductor publicador) escribe uidTaxista y
    // reinicia pickup en el mismo update; resource.uidTaxista aún no existe → debe permitirse
    // si solo es la transición abierta → acordada por quien publicó.
    function bolaPickupSoloTaxistaAsignado() {
      return !bolaPickupCamposCambiados() ||
        resource.data.uidTaxista == request.auth.uid ||
        resource.data.taxistaId == request.auth.uid ||
        (
          resource.data.createdByUid == request.auth.uid &&
          resource.data.estado == "abierta" &&
          request.resource.data.estado == "acordada"
        );
    }

    // Cancelar acordada solo antes de abordo / inicio (sin código verificado).
    function bolaCancelacionDesdeAcordadaOk() {
      return request.resource.data.estado != "cancelada" ||
        (
          resource.data.estado == "acordada" &&
          resource.data.pickupConfirmadoTaxista != true &&
          resource.data.codigoVerificado != true
        );
    }

    function bolaDocExists(bolaId) {
      return exists(/databases/$(database)/documents/bolas_pueblo/$(bolaId));
    }

    function bolaDocData(bolaId) {
      return get(/databases/$(database)/documents/bolas_pueblo/$(bolaId)).data;
    }

    function bolaPuedeChatMensajes(bolaId) {
      return isAuth() && bolaDocExists(bolaId) &&
        bolaDocData(bolaId).estado in ['acordada', 'en_curso'] &&
        (
          bolaDocData(bolaId).uidTaxista == request.auth.uid ||
          bolaDocData(bolaId).uidCliente == request.auth.uid
        );
    }

    // Mensaje nuevo: solo de/texto/ts; ts debe ser serverTimestamp (en reglas: == request.time).
    function bolaMensajeCreateOk() {
      return request.resource.data.keys().hasOnly(['de', 'texto', 'ts']) &&
        request.resource.data.de == request.auth.uid &&
        request.resource.data.texto is string &&
        request.resource.data.texto.size() > 0 &&
        request.resource.data.texto.size() <= 4000 &&
        request.resource.data.ts == request.time;
    }

    function hasKeys(obj, keys) {
      return obj.keys().hasAll(keys);
    }

    // Anti‑fraude: no cancelar/liberar desde app una vez a bordo o en curso.
    // Cliente → cancelado; taxista → cancelado (ya no se republica a pendiente).
    function viajeEstadoActual() {
      return 'estado' in resource.data ? resource.data.estado : '';
    }

    function viajeTrasAbordarOEnRuta() {
      return viajeEstadoActual() in ['a_bordo', 'abordo', 'en_curso', 'encurso'];
    }

    function clienteIntentaMarcarCancelado() {
      return 'estado' in request.resource.data && request.resource.data.estado == 'cancelado';
    }

    // Dueno del viaje (cliente): no exige rol en usuarios/.
    // Algunos docs tienen uidCliente vacio pero clienteId valido (motor/pool): OR evita denegar por '' == uid.
    function esDuenoClienteDelViaje() {
      return isAuth() && (
        resource.data.uidCliente == request.auth.uid ||
        resource.data.clienteId == request.auth.uid ||
        resource.data.uid == request.auth.uid
      );
    }

    function taxistaIntentaRepublicarPendiente() {
      return 'estado' in request.resource.data && request.resource.data.estado == 'pendiente';
    }

    function taxistaIntentaMarcarCancelado() {
      return 'estado' in request.resource.data && request.resource.data.estado == 'cancelado';
    }

    // Rol auxiliar (GoogleAuth / admin). Sin esta regla, el catch-all denegaba la lectura y el login con Google fallaba después de Auth.
    match /roles/{uid} {
      allow read: if isAuth() && (request.auth.uid == uid || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    match /usuarios/{uid} {
      allow read: if isAuth();
      // Crear en dos líneas: evita OR con isAdmin() + get(usuarios/uid) mientras se crea el mismo uid.
      allow create: if isOwner(uid) && usuarioSelfCreateSeguro();
      allow create: if isAdmin();
      // Actualizar perfil / disponibilidad: solo dueño + whitelist (sin isAdmin() en la misma expresión OR,
      // porque isAdmin() hace get(usuarios/auth.uid) y al escribir el propio doc eso es circular → permission-denied).
      allow update: if isOwner(uid) &&
        changedOnly([
          "nombre", "telefono", "fotoUrl", "direccion",
          "email", "proveedor", "lastLogin",
          "banco", "numeroCuenta", "titularCuenta",
          "ultimaActivacion",
          "viajeActivoId", "siguienteViajeId",
          "updatedAt", "actualizadoEn",
          "pushToken", "notificaciones",
          "aceptacionTerminos",
          "phoneVerified", "lastPhoneReauthAt",
          "registroClienteCompleto",
          "verificacionIdentidadEn", "verificacionIdentidadUrl",
          "empresaCorporativaId", "empresaCorporativaNombre"
        ]);
      // Disponibilidad operativa (toggle): aislado de campos de aprobación documental.
      allow update: if isOwner(uid) &&
        changedOnly([
          "disponible", "ultimaActivacion",
          "updatedAt", "actualizadoEn"
        ]);
      // Completar rol vacío al primer login (p. ej. Google); no permite cambiar a admin.
      allow update: if isOwner(uid) &&
        (!("rol" in resource.data) || resource.data.rol == "") &&
        changedOnly(["rol", "updatedAt", "actualizadoEn"]) &&
        request.resource.data.rol is string &&
        request.resource.data.rol in ["cliente", "taxista"];
      // Expediente: solo URLs de documentos (sin tocar estado de aprobación).
      allow update: if isOwner(uid) &&
        changedOnly([
          "docs",
          "updatedAt", "actualizadoEn"
        ]);
      // Enviar a revisión o marcar pendiente tras re-subida (nunca "aprobado").
      allow update: if isOwner(uid) &&
        changedOnly([
          "docs",
          "docsEstado", "estadoDocumentos", "docsEnviadosEn",
          "updatedAt", "actualizadoEn"
        ]) &&
        request.resource.data.docsEstado in ["pendiente", "en_revision"] &&
        request.resource.data.estadoDocumentos in ["pendiente", "en_revision"];
      // Marca cola ADM cuando RAI bloquea por muchas cancelaciones de salidas por cupos.
      allow update: if isOwner(uid) &&
        resource.data.rol == "taxista" &&
        changedOnly([
          "girasAbusoBloqueado",
          "girasAbusoBloqueadoEn",
          "updatedAt",
          "actualizadoEn"
        ]) &&
        request.resource.data.girasAbusoBloqueado == true;
      // Contadores giras por cupos (publicar / cancelar antes de iniciar; [PoolRepo.crearPool]).
      allow update: if isOwner(uid) &&
        resource.data.rol == "taxista" &&
        changedOnly([
          "girasCreadasUltimoMes",
          "girasCanceladasAntesDeIniciar",
          "ultimoReinicioContadorGiras",
          "updatedAt",
          "actualizadoEn"
        ]);
      // Completar registro conductor (Google / onboarding): datos + vehículo + estado docs inicial.
      allow update: if isOwner(uid) &&
        resource.data.rol == "taxista" &&
        changedOnly([
          "nombre", "telefono", "fotoUrl", "email", "proveedor",
          "registroTaxistaCompleto",
          "tipoServicio", "tipoVehiculo", "vehiculoTipo", "tipoVehiculoLabel",
          "placa", "marca", "modelo", "color", "anio", "vehiculoAnio",
          "vehiculoModelo", "vehiculoColor", "vehiculoMarca",
          "fotoVehiculoUrl", "vehiculoPerfilCompleto", "vehiculo",
          "docs",
          "disponible",
          "docsEstado", "estadoDocumentos", "documentosCompletos", "puedeRecibirViajes",
          "docsEnviadosEn",
          "ratingSuma", "ratingConteo", "fechaRegistro",
          "updatedAt", "actualizadoEn"
        ]) &&
        request.resource.data.documentosCompletos != true &&
        request.resource.data.puedeRecibirViajes != true &&
        (
          !("docsEstado" in request.resource.data) ||
          request.resource.data.docsEstado in ["pendiente", "en_revision"]
        ) &&
        (
          !("estadoDocumentos" in request.resource.data) ||
          request.resource.data.estadoDocumentos in ["pendiente", "en_revision"]
        );
      // Organizador de giras (sin vehículo): identidad + agencia; sin docs de chofer.
      allow update: if isOwner(uid) &&
        changedOnly([
          "nombre", "telefono", "whatsapp", "email", "proveedor", "fotoUrl",
          "cedula", "ciTaxista", "cedulaFotoUrl", "documentoIdentidadUrl",
          "agenciaNombre", "agenciaLogoUrl",
          "bancoNombre", "bancoCuenta", "bancoTipoCuenta", "bancoTitular",
          "perfilOperador", "tipoServicio", "soloGiras", "rol",
          "registroTaxistaCompleto", "registroOrganizadorGirasCompleto",
          "docsEstado", "estadoDocumentos", "documentosCompletos",
          "puedeRecibirViajes", "disponible",
          "updatedAt", "actualizadoEn"
        ]) &&
        request.resource.data.perfilOperador == "organizador_giras" &&
        request.resource.data.soloGiras == true &&
        request.resource.data.puedeRecibirViajes != true &&
        (
          !("docsEstado" in request.resource.data) ||
          request.resource.data.docsEstado in ["no_aplica", "pendiente", "en_revision"]
        ) &&
        (
          !("estadoDocumentos" in request.resource.data) ||
          request.resource.data.estadoDocumentos in ["no_aplica", "pendiente", "en_revision"]
        );
      // Edición de perfil organizador (foto, agencia, banco) tras el registro.
      allow update: if isOwner(uid) &&
        resource.data.perfilOperador == "organizador_giras" &&
        changedOnly([
          "nombre", "telefono", "whatsapp", "fotoUrl", "email",
          "agenciaNombre", "agenciaLogoUrl",
          "bancoNombre", "bancoCuenta", "bancoTipoCuenta", "bancoTitular",
          "updatedAt", "actualizadoEn"
        ]);
      // Firma de contrato conductor (solo aceptación; no revocación desde cliente).
      // Acepta taxista/driver o rol vacío en onboarding (antes de fijar rol).
      allow update: if isOwner(uid) &&
        (
          !("rol" in resource.data) ||
          resource.data.rol == "" ||
          resource.data.rol == "taxista" ||
          resource.data.rol == "driver"
        ) &&
        changedOnly([
          "contratoTaxistaAceptado", "contratoTaxistaVersion",
          "contratoTaxistaAceptadoEn", "contratoTaxistaFirmaTipo",
          "updatedAt", "actualizadoEn"
        ]) &&
        request.resource.data.contratoTaxistaAceptado == true;
      // Firma contrato corporativo (encargado) en su perfil de usuario.
      allow update: if isOwner(uid) &&
        changedOnly([
          "contratoCorporativoAceptado", "contratoCorporativoVersion",
          "contratoCorporativoEmpresaId", "contratoCorporativoAceptadoEn",
          "actualizadoEn", "updatedAt"
        ]) &&
        request.resource.data.contratoCorporativoAceptado == true;
      allow update: if isAdmin();
      allow delete: if isAdmin();

      /// Cola de promoción del taxista: solo lectura en cliente; escritura vía Admin SDK (callable).
      match /cola_viajes/{cid} {
        allow read: if isAuth() && (request.auth.uid == uid || isAdmin());
        allow create, update, delete: if false;
      }

      /// Respaldo documentos taxista cuando Storage devuelve 402/unknown (facturación / SHA APK local).
      match /docs_imagenes/{tipo} {
        allow read: if isAuth() && (request.auth.uid == uid || isAdmin());
        allow create, update: if isOwner(uid) &&
          tipo in ['licencia', 'matricula', 'seguro', 'fotoVehiculo', 'placa'] &&
          request.resource.data.keys().hasAll(['b64', 'contentType', 'updatedAt']) &&
          request.resource.data.b64 is string &&
          request.resource.data.b64.size() > 0 &&
          request.resource.data.b64.size() < 1200000 &&
          request.resource.data.contentType == 'image/jpeg';
        allow delete: if isOwner(uid) || isAdmin();
      }

      /// Viajes completados y pagados que el chofer quitó de su historial (no borra `viajes`).
      match /historial_viajes_ocultos/{viajeId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid) &&
          exists(/databases/$(database)/documents/viajes/$(viajeId)) &&
          (
            get(/databases/$(database)/documents/viajes/$(viajeId)).data.uidTaxista == request.auth.uid ||
            get(/databases/$(database)/documents/viajes/$(viajeId)).data.taxistaId == request.auth.uid
          ) &&
          get(/databases/$(database)/documents/viajes/$(viajeId)).data.completado == true &&
          (
            get(/databases/$(database)/documents/viajes/$(viajeId)).data.liquidado == true ||
            get(/databases/$(database)/documents/viajes/$(viajeId)).data.estadoPago in ['pagado', 'verificado', 'liquidado'] ||
            get(/databases/$(database)/documents/viajes/$(viajeId)).data.pagoATaxistaPendiente == false ||
            get(/databases/$(database)/documents/viajes/$(viajeId)).data.pagoTaxistaPendiente == false ||
            (
              'corporativoChoferPagadoEn' in get(/databases/$(database)/documents/viajes/$(viajeId)).data &&
              get(/databases/$(database)/documents/viajes/$(viajeId)).data.corporativoChoferPagadoEn != null
            )
          );
        allow delete: if isOwner(uid) || isAdmin();
        allow update: if false;
      }
    }

    match /viajes/{viajeId} {
      allow read: if isAdmin() ||
        // Lectura para taxista (requerida para query/listener del pool disponible).
        isTaxista() ||
        esRolChoferEnSesion() ||
        // Cliente dueño (uidCliente vacío + clienteId válido: ver esDuenoClienteDelViaje).
        esDuenoClienteDelViaje() ||
        (isAuth() && (
          resource.data.uidTaxista == request.auth.uid ||
          resource.data.taxistaId == request.auth.uid
        )) ||
        (isAuth() &&
          esViajeCorporativoDocData() &&
          resource.data.corporativoEmpresaId is string &&
          esEncargadoCorporativo(resource.data.corporativoEmpresaId)) ||
        // Pool visible para taxista (no asignado, no turismo/admin)
        (
          (isTaxista() || esRolChoferEnSesion()) &&
          (resource.data.uidTaxista == "" || resource.data.uidTaxista == null || !("uidTaxista" in resource.data)) &&
          (resource.data.taxistaId == "" || resource.data.taxistaId == null || !("taxistaId" in resource.data)) &&
          (
            resource.data.estado in [
              "pendiente",
              "pendiente_pago",
              "pendiente_admin",
              "pendienteAdmin",
              "buscando",
              "disponible"
            ]
          ) &&
          (
            !("tipoServicio" in resource.data) || resource.data.tipoServicio != "turismo"
          ) &&
          (
            !("canalAsignacion" in resource.data) || resource.data.canalAsignacion != "admin"
          )
        );

      allow create: if puedeCrearViajeComoCliente() &&
        request.resource.data.uidCliente == request.auth.uid &&
        request.resource.data.clienteId == request.auth.uid &&
        request.resource.data.uidTaxista == "" &&
        request.resource.data.taxistaId == "" &&
        !request.resource.data.keys().hasAny(["referenciaRecaudo", "recaudoDestino"]) &&
        !request.resource.data.keys().hasAny([
          "qrRecaudoPayload", "qrRecaudoTipo", "qrRecaudoVersion",
          "qrRecaudoGeneradoEn", "qrRecaudoEstado", "pagoAzulId"
        ]) &&
        viajeCreateClienteFlagsPagoInicialesOk() &&
        // Creación cliente: sin cerrar finanzas ni validar pagos.
        !request.resource.data.keys().hasAny(viajeCamposFinancierosProtegidosEnCreateCliente()) &&
        !request.resource.data.keys().hasAny([
          "settlement",
          "pagoDetalle"
        ]);

      allow update: if (isAdmin() && viajeNoTocaCamposFinancierosProtegidos()) ||
        (
          // CLAIM pool (motor / vehículo): mismo rol que lectura del pool (taxista | driver).
          esRolChoferEnSesion() &&
          taxistaSinDeuda(request.auth.uid) &&
          taxistaAptoParaClaimPool(request.auth.uid) &&
          (resource.data.uidTaxista == "" || resource.data.uidTaxista == null || !("uidTaxista" in resource.data)) &&
          (resource.data.taxistaId == "" || resource.data.taxistaId == null || !("taxistaId" in resource.data)) &&
          request.resource.data.uidTaxista == request.auth.uid &&
          request.resource.data.taxistaId == request.auth.uid &&
          request.resource.data.aceptado == true &&
          request.resource.data.activo == true &&
          (request.resource.data.estado in ["aceptado", "en_camino_pickup", "enCaminoPickup"])
        ) ||
        (
          esDuenoClienteDelViaje() &&
          viajeNoTocaCamposFinancierosProtegidos() &&
          changedOnly([
            "estado", "aceptado", "rechazado", "activo",
            "uidTaxista", "taxistaId", "nombreTaxista",
            "telefono", "placa", "marca", "modelo", "color",
            "comprobanteTransferenciaUrl",
            "transferenciaReportadaEn",
            "motivoRechazoTransferencia",
            "canceladoPor", "motivoCancelacion", "canceladoClienteEn",
            "canceladoTaxistaEn", "republicado",
            "reportado",
            "updatedAt", "actualizadoEn"
          ]) &&
          // Cliente no puede forzar en_curso ni cerrar viaje desde app.
          !(request.resource.data.estado in ["en_curso", "encurso", "completado"]) &&
          !(clienteIntentaMarcarCancelado() && viajeTrasAbordarOEnRuta())
        ) ||
        (
          // Post-viaje (efectivo): el cliente marca que vio el resumen/recibo — solo estos campos.
          esDuenoClienteDelViaje() &&
          viajeNoTocaCamposFinancierosProtegidos() &&
          (resource.data.completado == true ||
            resource.data.estado == "completado" ||
            resource.data.estado == "finalizado") &&
          changedOnly([
            "clienteFacturaEfectivoVistaEn",
            "clienteFacturaEfectivoVistaPorUid",
            "clientePostViajeVistoEn",
            "clientePostViajeVistoPorUid",
            "solicitarCalificacionMutua",
            "solicitarCalificacionMutuaEn",
            "solicitarCalificacionMutuaPorUid"
          ]) &&
          (
            !request.resource.data.keys().hasAny(["clienteFacturaEfectivoVistaPorUid"]) ||
            request.resource.data.clienteFacturaEfectivoVistaPorUid == request.auth.uid
          ) &&
          (
            !request.resource.data.keys().hasAny(["clientePostViajeVistoPorUid"]) ||
            request.resource.data.clientePostViajeVistoPorUid == request.auth.uid
          ) &&
          (
            !request.resource.data.keys().hasAny(["solicitarCalificacionMutuaPorUid"]) ||
            request.resource.data.solicitarCalificacionMutuaPorUid == request.auth.uid
          )
        ) ||
        (
          // Post-viaje: marcar reportado (ReportesViajeData) en viaje ya cerrado.
          // No encaja en el bloque anterior porque ese bloque exige campos de factura efectivo;
          // el bloque de cliente "activo" niega request.resource.data.estado == "completado".
          esDuenoClienteDelViaje() &&
          viajeNoTocaCamposFinancierosProtegidos() &&
          (
            resource.data.completado == true ||
            resource.data.estado == "completado" ||
            resource.data.estado == "finalizado"
          ) &&
          changedOnly([
            "reportado",
            "updatedAt",
            "actualizadoEn"
          ]) &&
          request.resource.data.reportado == true
        ) ||
        (
          // Claim pool: exige rol chofer.
          // Operación ya asignada (GPS / en_camino_pickup): basta ser el uidTaxista del viaje
          // (aceptarViajeSeguro usa Admin SDK y puede haber rol solo en roles/{uid}).
          (
            esRolChoferEnSesion() &&
            taxistaSinDeuda(request.auth.uid) &&
            taxistaAptoParaClaimPool(request.auth.uid) &&
            (
              (resource.data.uidTaxista == "" || resource.data.uidTaxista == null || !("uidTaxista" in resource.data)) &&
              (resource.data.taxistaId == "" || resource.data.taxistaId == null || !("taxistaId" in resource.data))
            ) &&
            request.resource.data.uidTaxista == request.auth.uid &&
            request.resource.data.taxistaId == request.auth.uid &&
            changedOnly([
              "uidTaxista", "taxistaId", "nombreTaxista",
              "telefono", "placa", "tipoVehiculo", "tipoVehiculoOriginal",
              "marca", "modelo", "color",
              "latTaxista", "lonTaxista", "driverLat", "driverLon",
              "estado", "aceptado", "rechazado", "activo",
              "aceptadoEn", "updatedAt", "actualizadoEn",
              "reservadoPor", "reservadoHasta", "ignoradosPor",
              "bolaNegociacionAbierta"
            ])
          ) ||
          // Operación de viaje ya asignado (GPS/estado): NO bloquear por deuda ni por rol vacío.
          (
            isAuth() &&
            (resource.data.uidTaxista == request.auth.uid || resource.data.taxistaId == request.auth.uid)
            &&
            viajeNoTocaCamposFinancierosProtegidos() &&
            changedOnly([
              "estado", "aceptado", "rechazado", "activo",
              "updatedAt", "actualizadoEn",
              "latTaxista", "lonTaxista", "driverLat", "driverLon",
              "pickupConfirmadoEn", "inicioEnRutaEn", "viajeIniciadoEn", "finalizadoEn",
              "clienteAbordo", "clienteAbordoEn",
              "codigoVerificacion", "codigoVerificado", "codigoVerificadoEn",
              "canceladoPor", "canceladoTaxistaEn", "motivoCancelacion",
              "uidTaxista", "taxistaId", "nombreTaxista",
              "telefono", "placa", "marca", "modelo", "color",
              "reservadoPor", "reservadoHasta", "ignoradosPor",
              "republicado", "completado", "esAhora"
            ])
            &&
            // En curso solo si ya estaba verificado por backend (callable).
            (!(request.resource.data.estado in ["en_curso", "encurso"]) ||
              resource.data.codigoVerificado == true)
            &&
            request.resource.data.estado != "completado" &&
            request.resource.data.completado != true
            &&
            !(viajeTrasAbordarOEnRuta() && taxistaIntentaRepublicarPendiente())
            &&
            !(viajeTrasAbordarOEnRuta() && taxistaIntentaMarcarCancelado())
            &&
            // Ya no se republica: cancelar desde app debe ir a cancelado (CF) o fallar.
            !(
              viajeEstadoActual() in [
                'aceptado',
                'en_camino_pickup',
                'enCaminoPickup'
              ] &&
              taxistaIntentaRepublicarPendiente()
            )
          )
        ) ||
        (
          // Abrir ruta corporativa fija (cola → viaje en curso): sin reglas de claim pool.
          esRolChoferEnSesion() &&
          esViajeCorporativoDocData() &&
          esChoferCorporativoDelViaje() &&
          viajeNoTocaCamposFinancierosProtegidos() &&
          request.resource.data.uidTaxista == request.auth.uid &&
          request.resource.data.taxistaId == request.auth.uid &&
          request.resource.data.aceptado == true &&
          request.resource.data.activo == true &&
          request.resource.data.estado in ["aceptado", "en_camino_pickup", "enCaminoPickup"] &&
          changedOnly([
            "canalAsignacion",
            "corporativoChoferAsignadoUid",
            "uidTaxista", "taxistaId", "nombreTaxista",
            "telefono", "placa", "tipoVehiculo",
            "estado", "aceptado", "rechazado", "activo",
            "aceptadoEn", "updatedAt", "actualizadoEn"
          ])
        ) ||
        esPatchRutaCorpInformativaChofer();

      allow delete: if false;

      // Trazabilidad GPS corporativa (chofer durante viaje en curso).
      match /gps_track/{puntoId} {
        allow read: if isAdmin() ||
          (isAuth() && (
            get(/databases/$(database)/documents/viajes/$(viajeId)).data.uidTaxista == request.auth.uid ||
            get(/databases/$(database)/documents/viajes/$(viajeId)).data.taxistaId == request.auth.uid ||
            get(/databases/$(database)/documents/viajes/$(viajeId)).data.uidCliente == request.auth.uid
          ));
        allow create: if isAuth() &&
          (
            get(/databases/$(database)/documents/viajes/$(viajeId)).data.corporativo == true ||
            get(/databases/$(database)/documents/viajes/$(viajeId)).data.categoria == "corporativo"
          ) &&
          (
            get(/databases/$(database)/documents/viajes/$(viajeId)).data.uidTaxista == request.auth.uid ||
            get(/databases/$(database)/documents/viajes/$(viajeId)).data.taxistaId == request.auth.uid
          ) &&
          request.resource.data.keys().hasAll(['lat', 'lon', 'timestamp', 'tipo']) &&
          request.resource.data.lat is number &&
          request.resource.data.lon is number &&
          request.resource.data.tipo in ['inicio', 'parada', 'en_ruta', 'fin'];
        allow update, delete: if false;
      }
    }

    match /pagos/{pagoId} {
      allow read: if isAdmin() ||
        (isAuth() && resource.data.uidTaxista == request.auth.uid);
      allow create: if isAdmin() &&
        hasKeys(request.resource.data, [
          "tipo", "viajeId", "uidTaxista", "monto",
          "metodo", "estado", "fecha", "createdAt"
        ]);
      // Asiento al completar viaje (ViajesRepo.completarViajePorTaxista)
      allow create: if isTaxista() &&
        request.resource.data.uidTaxista == request.auth.uid &&
        request.resource.data.tipo == "taxista" &&
        request.resource.data.viajeId is string &&
        hasKeys(request.resource.data, [
          "tipo", "viajeId", "uidTaxista", "monto",
          "metodo", "estado", "fecha", "createdAt"
        ]);
      // Recibo firmado (FirmarPago)
      allow create: if isTaxista() &&
        request.resource.data.keys().hasAll([
          "emailTaxista", "monto", "metodo", "fecha", "firmaUrl"
        ]) &&
        request.resource.data.monto is number &&
        request.resource.data.metodo is string &&
        request.resource.data.firmaUrl is string;
      allow update, delete: if false;
    }

    match /billeteras_taxista/{uidTaxista} {
      allow read: if isAdmin() || isOwner(uidTaxista);
      allow create: if isAdmin() || (isOwner(uidTaxista) && isTaxista());
      allow update: if isAdmin();
      allow delete: if false;

      // Auditoría prepago comisión: solo Admin SDK / admin app.
      match /movimientos_prepago/{movId} {
        allow read: if isAdmin() || isOwner(uidTaxista);
        allow create, update, delete: if isAdmin();
      }
    }

    match /pagos_taxistas/{pagoId} {
      allow read: if isAdmin() ||
        (isAuth() && resource.data.uidTaxista == request.auth.uid);
      allow create: if !pr2PagosTaxistasEscrituraDeshabilitada() && isAdmin();
      allow update: if !pr2PagosTaxistasEscrituraDeshabilitada() && (
        isAdmin() || (
          isTaxista() &&
          resource.data.uidTaxista == request.auth.uid &&
          changedOnly(["comprobanteUrl", "metodoPago", "estado", "updatedAt"]) &&
          (resource.data.estado in ["pendiente", "rechazado"]) &&
          request.resource.data.estado == "pendiente_verificacion"
        )
      );
      allow delete: if false;
    }

    // Fase 3 — extracto Banco Popular (solo Admin SDK / callables admin).
    match /movimientos_banco/{movId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /import_batches_banco/{batchId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    // Fase 4 — conciliaciones banco ↔ viaje (solo Admin SDK / callables admin).
    match /conciliaciones/{concId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    // Fase 6 — pagos AZUL (solo Cloud Functions).
    match /pagos_azul/{pagoAzulId} {
      allow read: if isAdmin() ||
        (isAuth() && (
          resource.data.uidCliente == request.auth.uid ||
          get(/databases/$(database)/documents/viajes/$(resource.data.viajeId)).data.uidTaxista == request.auth.uid ||
          get(/databases/$(database)/documents/viajes/$(resource.data.viajeId)).data.taxistaId == request.auth.uid
        ));
      allow create, update, delete: if false;
    }

    // Liquidación semanal digital (PR2): solo lectura cliente; escritura vía Cloud Functions.
    match /liquidaciones_semanales/{liqId} {
      allow read: if isAdmin() ||
        (isAuth() && resource.data.uidTaxista == request.auth.uid);
      allow create, update, delete: if false;

      match /lineas/{viajeId} {
        allow read: if isAdmin() ||
          (isAuth() &&
            get(/databases/$(database)/documents/liquidaciones_semanales/$(liqId))
              .data.uidTaxista == request.auth.uid);
        allow create, update, delete: if false;
      }
    }

    // Recarga de comisión por viajes en efectivo: taxista crea con comprobante;
    // aprobación/rechazo solo vía Cloud Functions (Admin SDK).
    match /recargas_comision_taxista/{id} {
      allow read: if isAdmin() ||
        (isTaxista() && resource.data.uidTaxista == request.auth.uid);
      allow create: if isTaxista() &&
        request.resource.data.uidTaxista == request.auth.uid &&
        request.resource.data.estado == "pendiente_verificacion" &&
        request.resource.data.comprobanteUrl is string &&
        request.resource.data.comprobanteUrl.size() > 10 &&
        request.resource.data.montoDeclaradoRd is number &&
        request.resource.data.montoDeclaradoRd > 0 &&
        request.resource.data.comisionPendienteAlEnviar is number &&
        request.resource.data.saldoPrepagoAlEnviar is number &&
        hasKeys(request.resource.data, [
          "uidTaxista", "nombreTaxista", "comisionPendienteAlEnviar",
          "saldoPrepagoAlEnviar",
          "montoDeclaradoRd", "comprobanteUrl", "metodoPago", "estado",
          "createdAt", "updatedAt"
        ]);
      allow update, delete: if false;
    }

    // Liquidaciones administrativas (tabs: pendiente/aprobado/rechazado)
    match /liquidaciones/{liqId} {
      allow read: if isAdmin() || (
        isAuth() &&
        resource.data.uidTaxista == request.auth.uid
      );
      allow create: if isAdmin() || (
        isAuth() &&
        request.resource.data.uidTaxista == request.auth.uid
      );
      allow update: if isAdmin();
      allow delete: if false;
    }

    // Promociones de comisión por taxista (lectura del propio taxista para cálculo)
    match /promociones_taxistas/{promoId} {
      allow read: if isAdmin() ||
        (isAuth() && resource.data.uidTaxista == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }

    // Calificaciones bidireccionales (solo Cloud Functions escriben).
    match /calificaciones/{id} {
      allow read: if isAdmin() ||
        (isAuth() && (
          resource.data.clienteId == request.auth.uid ||
          resource.data.taxistaId == request.auth.uid
        ));
      allow create, update, delete: if false;
    }

    match /reportes_viaje/{id} {
      allow read: if isAdmin();
      // Escritura solo vía callable [reportarProblema] (Admin SDK).
      allow create: if false;
      allow update: if isAdmin();
      allow delete: if false;
    }

    // Configuración operativa (promociones, flags, etc.)
    match /config/{docId} {
      // Clientes/taxistas/admin deben poder leer promociones activas
      allow read: if isAuth();
      // Solo admin puede crear/editar configuración (por defecto).
      // Para configuraciones críticas, preferimos actualización vía Cloud Functions + historial.
      allow create, update, delete: if isAdmin() &&
        docId != "comision_prepago" &&
        docId != "comision" &&
        docId != "comision_incentivos_taxista" &&
        docId != "promo_3x1" &&
        docId != "promociones" &&
        docId != "tarifas_tramos";
    }

    // Porcentaje global de comisión viaje efectivo (solo callable admin + Admin SDK).
    match /config/comision {
      allow read: if isAuth();
      allow create, update, delete: if false;
    }

    // Configuración crítica: comisiones prepago (solo vía Cloud Functions; el cliente solo lee).
    match /config/comision_prepago {
      allow read: if isAuth();
      allow create, update, delete: if false;
    }

    // Incentivos comisión por volumen (solo callable admin + Admin SDK en finalizar).
    match /config/comision_incentivos_taxista {
      allow read: if isAuth();
      allow create, update, delete: if false;
    }

    // Contador de viajes completados por ventana (solo Admin SDK escribe).
    match /taxistas_stats/{uid} {
      allow read: if isAuth() && (request.auth.uid == uid || isAdmin());
      allow create, update, delete: if false;
    }

    // Tarifas generales (usadas por cálculo de precio en app)
    match /tarifas/{docId} {
      allow read: if isAuth();
      // Crítico: evitar cambios directos desde cliente; usar callable admin con historial.
      allow create, update, delete: if false;
    }

    // Tarifario de turismo por tipo de vehículo
    match /tarifa_turismo/{docId} {
      allow read: if isAuth();
      // Crítico: evitar cambios directos desde cliente; usar callable admin con historial.
      allow create, update, delete: if false;
    }

    // Historial inmutable de cambios críticos (solo lectura admin).
    match /configuraciones_historial/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Parámetros globales (ej. comisión gira); solo admin escribe.
    match /configuracion_globals/{docId} {
      allow read: if isAuth();
      allow create, update, delete: if isAdmin();
    }

    // Viajes por cupos (giras): lectura en app; escritura solo Admin SDK (CF) o admin manual.
    match /viajes_pool/{poolId} {
      allow read: if isAuth();

      // crearPoolGira / reservePoolSeats / startPoolTrip / finalizePoolTrip → Cloud Functions.
      allow create: if false;

      // Admin: correcciones manuales (ej. validar comisión gira legacy en Verificar pagos).
      allow update, delete: if isAdmin();

      match /reservas/{reservaId} {
        // Lectura cliente/taxista del pool (path concreto). Admin también puede usar
        // match /{path=**}/reservas abajo para collectionGroup sin get(padre).
        allow read: if isAdmin() ||
          (isAuth() && (
            resource.data.uidCliente == request.auth.uid ||
            get(/databases/$(database)/documents/viajes_pool/$(poolId)).data.ownerTaxistaId == request.auth.uid
          ));

        // reservePoolSeats / cancelPoolReservation / verifyPoolReservaRecaudo → Cloud Functions.
        allow create, update, delete: if false;
      }
    }

    // Collection group `reservas` (Verificar pagos · Giras RAI · Mis giras cliente).
    // Las queries collectionGroup no pueden usar reglas con get(viajes_pool/...).
    match /{path=**}/reservas/{reservaId} {
      allow read: if isAdmin() ||
        (isAuth() && resource.data.uidCliente == request.auth.uid);
    }

    // Ledger comisiones giras: solo Cloud Functions / admin (evita manipulación desde cliente).
    match /ledger_giras/{entryId} {
      allow read: if isAdmin() ||
        (isAuth() && resource.data.uidTaxista == request.auth.uid);
      allow create, update, delete: if false;
    }

    // Tickets entrada giras: solo Cloud Functions (índice token → reserva).
    match /gira_tickets/{tokenId} {
      allow read, write: if false;
    }

    match /ledger_pool_reservas/{entryId} {
      allow read: if isAdmin() ||
        (isAuth() && resource.data.ownerTaxistaId == request.auth.uid);
      allow create, update, delete: if false;
    }

    match /liquidaciones_pool/{liqId} {
      // Admin: listado por estado (Verificar pagos · neto organizador).
      allow list: if isAdmin();
      allow get: if isAdmin() ||
        (isAuth() && resource.data.ownerTaxistaId == request.auth.uid);
      allow create, update, delete: if false;
    }

    // Chat del viaje: doc id == viajeId (ViajesRepo / ChatRepo)
    function datosViajeChat(viajeId) {
      return get(/databases/$(database)/documents/viajes/$(viajeId)).data;
    }

    function esEncargadoDelViajeCorporativo(viajeId) {
      let v = datosViajeChat(viajeId);
      let empId = v.corporativoEmpresaId is string ? v.corporativoEmpresaId : "";
      return empId != "" && esEncargadoCorporativo(empId);
    }

    function esParticipanteViajeChat(viajeId) {
      return isAuth() && exists(/databases/$(database)/documents/viajes/$(viajeId)) &&
        (
          datosViajeChat(viajeId).uidCliente == request.auth.uid ||
          datosViajeChat(viajeId).clienteId == request.auth.uid ||
          datosViajeChat(viajeId).uidTaxista == request.auth.uid ||
          datosViajeChat(viajeId).taxistaId == request.auth.uid ||
          datosViajeChat(viajeId).corporativoChoferAsignadoUid == request.auth.uid ||
          datosViajeChat(viajeId).corporativoChoferPreferidoUid == request.auth.uid ||
          esEncargadoDelViajeCorporativo(viajeId)
        );
    }

    match /chats/{chatId} {
      allow read: if esParticipanteViajeChat(chatId);
      allow create: if esParticipanteViajeChat(chatId) &&
        request.resource.data.viajeId == chatId &&
        request.resource.data.participantes is list &&
        request.auth.uid in request.resource.data.participantes;
      allow update: if esParticipanteViajeChat(chatId) &&
        changedOnly(["lastMessage", "lastAt", "participantes", "viajeId"]);
    }

    match /chats/{chatId}/mensajes/{msgId} {
      allow read: if esParticipanteViajeChat(chatId);
      allow create: if esParticipanteViajeChat(chatId) &&
        request.resource.data.de == request.auth.uid &&
        request.resource.data.texto is string &&
        request.resource.data.texto.size() > 0 &&
        request.resource.data.texto.size() <= 4000;
      allow update, delete: if false;
    }

    // --- Colecciones usadas por la app y no cubiertas arriba ---

    match /choferes_turismo/{uid} {
      allow read: if isAuth();
      allow create, update: if isAdmin() || (isOwner(uid) && isTaxista());
      allow delete: if isAdmin();
    }

    match /choferes_corporativos/{uid} {
      allow read: if isAuth();
      allow create, update, delete: if isAdmin();
    }

    /// Panel único tiempo real del chofer corporativo (solo Cloud Functions escribe).
    match /chofer_operacion/{uid} {
      allow read: if isAdmin() || isOwner(uid);
      allow write: if false;
    }

    match /solicitudes_corporativo/{id} {
      allow read: if isAdmin() ||
        (isAuth() && resource.data.uidChofer == request.auth.uid);
      allow create: if isAuth() &&
        request.resource.data.uidChofer == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /seguridad/{uid} {
      allow read, write: if isOwner(uid);
    }

    match /app_config/{docId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    match /drivers_location/{uid} {
      allow read: if isAuth();
      allow write: if isOwner(uid);
    }

    match /taxistas/{uid} {
      allow read: if isAuth();
      allow write: if isOwner(uid);
    }

    match /pagos_taxista/{pagoId} {
      allow read: if isAdmin() ||
        (isAuth() && resource.data.uidTaxista == request.auth.uid);
      allow create: if isTaxista() &&
        request.resource.data.uidTaxista == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /billeteras/{uidTaxista}/movimientos/{movId} {
      allow read: if isAdmin() || isOwner(uidTaxista);
      allow create, update: if isAdmin() || (isOwner(uidTaxista) && isTaxista());
      allow delete: if isAdmin();
    }

    match /push_tokens/{uid} {
      allow read, write: if isOwner(uid);
    }

    match /solicitudes_turismo/{id} {
      allow read: if isAdmin() ||
        (isAuth() && resource.data.uidChofer == request.auth.uid);
      allow create: if isAuth() &&
        request.resource.data.uidChofer == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Módulo aislado: "Pide tu bola (pueblo a pueblo)".
    match /bolas_pueblo/{bolaId} {
      allow read: if isAuth();

      allow create: if isAuth() &&
        myUserDocExists() &&
        request.resource.data.createdByUid == request.auth.uid &&
        request.resource.data.tipo in ["pedido", "oferta"] &&
        bolaPuebloCreateRolTipoCoherente() &&
        request.resource.data.estado == "abierta" &&
        request.resource.data.distanciaKm is number &&
        request.resource.data.distanciaKm > 0 &&
        request.resource.data.tarifaNormalRd is number &&
        request.resource.data.tarifaBaseBolaRd is number &&
        request.resource.data.ofertaMinRd is number &&
        request.resource.data.ofertaMaxRd is number &&
        request.resource.data.ofertaMinRd <= request.resource.data.ofertaMaxRd;

      // Dueño: puede cerrar/cancelar y actualizar metadata operativa.
      allow update: if isAdmin() || (
        isAuth() &&
        !bolaCierreFinancieroSoloServidor() &&
        bolaTransicionAcuerdoSoloServidor() &&
        (
          resource.data.createdByUid == request.auth.uid ||
          resource.data.uidTaxista == request.auth.uid ||
          resource.data.taxistaId == request.auth.uid ||
          resource.data.uidCliente == request.auth.uid
        ) &&
        changedOnly([
          "estado", "ofertaAceptadaId", "nota", "updatedAt",
          "montoAcordadoRd", "comisionPct", "comisionRd",
          "gananciaNetaChoferRd", "acordadaEn",
          "uidTaxista", "taxistaId", "uidCliente", "estadoViajeBola",
          "inicioEn", "finalizadaEn",
          "confirmacionTaxistaFinal", "confirmacionClienteFinal",
          "confirmacionTaxistaFinalEn", "confirmacionClienteFinalEn",
          "comisionAplicada",
          "codigoVerificacionBola", "codigoGeneradoEn",
          "codigoVerificado", "codigoVerificadoEn",
          "pickupConfirmadoTaxista", "pickupConfirmadoTaxistaEn",
          "canceladaEn",
          "canceladaPor",
          "metodoPago", "metodoPagoUpdatedBy", "metodoPagoUpdatedAt",
          "taxistaFacturaBolaVistaEn", "taxistaFacturaBolaVistaPorUid",
          "clienteFacturaBolaVistaEn", "clienteFacturaBolaVistaPorUid",
          // Espejo Bola Ahorro (cliente): ver bola_pueblo_firestore_sync.dart
          "viajeEspejoId", "negociacionCerrada", "errorSync", "errorSyncViajeEspejo"
        ]) &&
        bolaFinalizacionPermitida() &&
        bolaComisionPermitida() &&
        bolaPickupSoloTaxistaAsignado() &&
        bolaCancelacionDesdeAcordadaOk()
      );

      allow delete: if false;

      match /ofertas/{ofertaId} {
        allow read: if isAuth();

        // Ofertas: en [pedido] solo choferes; en [oferta] «Voy para» solo pasajeros.
        // Contraoferta (pedido): el publicador cliente responde a un chofer.
        allow create: if isAuth() &&
          myUserDocExists() &&
          get(/databases/$(database)/documents/bolas_pueblo/$(bolaId)).data.estado == "abierta" &&
          request.resource.data.estado == "pendiente" &&
          request.resource.data.fromUid == request.auth.uid &&
          request.resource.data.fromRol is string &&
          request.resource.data.fromRol == myRole() &&
          request.resource.data.montoRd is number &&
          request.resource.data.montoRd > 0 &&
          request.resource.data.montoRd >= get(/databases/$(database)/documents/bolas_pueblo/$(bolaId)).data.ofertaMinRd &&
          request.resource.data.montoRd <= get(/databases/$(database)/documents/bolas_pueblo/$(bolaId)).data.ofertaMaxRd &&
          (
            (
              get(/databases/$(database)/documents/bolas_pueblo/$(bolaId)).data.createdByUid != request.auth.uid &&
              (!("esContraofertaCliente" in request.resource.data) || request.resource.data.esContraofertaCliente != true) &&
              (
                (
                  get(/databases/$(database)/documents/bolas_pueblo/$(bolaId)).data.tipo == "pedido" &&
                  esRolChoferEnSesion()
                ) ||
                (
                  get(/databases/$(database)/documents/bolas_pueblo/$(bolaId)).data.tipo == "oferta" &&
                  myRole() == "cliente"
                )
              )
            ) ||
            (
              get(/databases/$(database)/documents/bolas_pueblo/$(bolaId)).data.tipo == "pedido" &&
              get(/databases/$(database)/documents/bolas_pueblo/$(bolaId)).data.createdByUid == request.auth.uid &&
              myRole() == "cliente" &&
              request.resource.data.esContraofertaCliente == true &&
              request.resource.data.contraOfertaParaUid is string &&
              request.resource.data.contraOfertaParaUid.size() > 0 &&
              request.resource.data.contraOfertaParaUid != request.auth.uid
            ) ||
            (
              get(/databases/$(database)/documents/bolas_pueblo/$(bolaId)).data.tipo == "oferta" &&
              get(/databases/$(database)/documents/bolas_pueblo/$(bolaId)).data.createdByUid == request.auth.uid &&
              esRolChoferEnSesion() &&
              request.resource.data.esContraofertaConductor == true &&
              request.resource.data.contraOfertaParaUid is string &&
              request.resource.data.contraOfertaParaUid.size() > 0 &&
              request.resource.data.contraOfertaParaUid != request.auth.uid
            )
          );

        // Dueño de la publicación (o admin) puede aceptar/rechazar; ofertante puede retirar.
        allow update: if isAdmin() || (
          isAuth() &&
          (
            get(/databases/$(database)/documents/bolas_pueblo/$(bolaId)).data.createdByUid == request.auth.uid ||
            resource.data.fromUid == request.auth.uid
          ) &&
          request.resource.data.estado != "aceptada" &&
          changedOnly(["estado", "updatedAt"])
        );

        allow delete: if false;
      }

      match /mensajes_bola/{msgId} {
        allow read: if bolaPuedeChatMensajes(bolaId);
        allow create: if bolaPuedeChatMensajes(bolaId) && bolaMensajeCreateOk();
        allow update, delete: if false;
      }
    }

    // Gestión de incidencias (soporte): solo administración.
    match /incidencias/{incidenciaId} {
      allow read, create, update: if isAdmin();
      allow delete: if false;
    }

    // Mensajes cliente → operaciones turismo (panel ADM en tiempo real).
    match /turismo_mensajes_adm/{msgId} {
      allow read: if isAdmin() ||
        (isAuth() && resource.data.uidCliente == request.auth.uid);
      allow create: if isAuth() &&
        request.resource.data.uidCliente == request.auth.uid &&
        request.resource.data.leidoPorAdm == false &&
        request.resource.data.mensaje is string &&
        request.resource.data.mensaje.size() > 0 &&
        request.resource.data.mensaje.size() <= 500 &&
        request.resource.data.viajeId is string &&
        request.resource.data.viajeId.size() > 0 &&
        exists(/databases/$(database)/documents/viajes/$(request.resource.data.viajeId)) &&
        get(/databases/$(database)/documents/viajes/$(request.resource.data.viajeId)).data.tipoServicio == 'turismo' &&
        (
          get(/databases/$(database)/documents/viajes/$(request.resource.data.viajeId)).data.uidCliente == request.auth.uid ||
          get(/databases/$(database)/documents/viajes/$(request.resource.data.viajeId)).data.clienteId == request.auth.uid
        );
      allow update: if isAdmin() &&
        changedOnly(['leidoPorAdm', 'leidoEn']);
      allow delete: if false;
    }

    // Alertas operativas in-app (escritura solo Cloud Functions / Admin SDK).
    match /admin_alertas/{alertaId} {
      allow read, update: if isAdmin();
      allow create, delete: if false;
    }

    // Métricas agregadas del centro de operaciones (escritura solo backend).
    match /admin_metrics/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Uso diario del asistente RAI (lectura admin; escritura solo CF).
    match /rai_asistente_usage/{uid} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Destinos turísticos editables desde ADM (catálogo extendido).
    match /turismo_destinos/{destinoId} {
      allow read: if isAuth();
      allow create, update, delete: if isAdmin();
    }

    // Auditoría administrativa: solo Cloud Functions (Admin SDK). Clientes nunca leen/escriben.
    match /admin_audit/{docId} {
      allow read, write: if false;
    }

      match /empresas_corporativas/{empresaId} {
      // Admin primero (listados globales: Cuentas / Empresas).
      allow read: if isAdmin();
      // Encargado: solo su(s) empresa(s).
      allow read: if esEncargadoCorporativoResource();
      // Chofer corporativo: logo/nombre en historial y rutas (solo get, no list).
      allow get: if esChoferCorporativoAprobado();
      allow create: if isAuth() &&
        request.resource.data.encargadoUids is list &&
        request.auth.uid in request.resource.data.encargadoUids &&
        request.resource.data.contratoActivo == false;
      // Firma digital B2B del encargado (no activa el servicio; eso es contratoActivo / admin).
      allow update: if esEncargadoCorporativo(empresaId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'contratoCorporativoAceptado',
          'contratoCorporativoVersion',
          'contratoCorporativoAceptadoEn',
          'contratoCorporativoAceptadoPorUid',
          'contratoCorporativoFirmaTipo',
          'actualizadoEn',
          'updatedAt'
        ]) &&
        request.resource.data.contratoCorporativoAceptado == true &&
        request.resource.data.contratoCorporativoVersion is string &&
        request.resource.data.contratoCorporativoVersion.size() > 0;
      // Encargado puede editar datos comerciales + ciclo/forma de pago a RAI.
      // No toca período abierto, deuda, tarifa, contratoActivo ni encargados.
      // facturacionCicloDias solo afecta el *próximo* corte (renew/archive en CF).
      allow update: if isAdmin() || (
        esEncargadoCorporativo(empresaId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'periodoActual',
          'activa',
          'contratoActivo',
          'contratoDesde',
          'contratoHasta',
          'encargadoUids',
          'ultimoPagoEn',
          'ultimoPagoReportado',
          'tarifaViajeContratadaRd',
          'creadoPorUid',
          'contratoActivadoEn',
          'contratoActivadoPorUid',
          'servicioTipo'
        ]) &&
        (
          !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['facturacionCicloDias']) ||
          (
            request.resource.data.facturacionCicloDias is number &&
            request.resource.data.facturacionCicloDias >= 1 &&
            request.resource.data.facturacionCicloDias <= 90
          )
        ) &&
        (
          !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['formaPagoRai']) ||
          (
            request.resource.data.formaPagoRai is string &&
            request.resource.data.formaPagoRai in [
              '', 'transferencia', 'deposito', 'cheque', 'efectivo', 'otro'
            ]
          )
        )
      );
      allow delete: if isAdmin();

      match /plantillas_ruta/{plantillaId} {
        allow read: if isAdmin() ||
          esEncargadoCorporativo(empresaId) ||
          (
            isTaxista() &&
            resource.data.choferPreferidoUid == request.auth.uid
          );
        allow create: if isAdmin() || (
          esEncargadoCorporativo(empresaId) &&
          !request.resource.data.keys().hasAny([
            'choferPreferidoUid',
            'choferPreferidoNombre',
            'choferPreferidoTelefono',
            'choferAsignadoPerfil',
            'choferAsignacion',
          ])
        );
        allow update: if isAdmin() || (
          esEncargadoCorporativo(empresaId) &&
          request.resource.data.get('choferPreferidoUid', '') ==
              resource.data.get('choferPreferidoUid', '') &&
          request.resource.data.get('choferPreferidoNombre', '') ==
              resource.data.get('choferPreferidoNombre', '') &&
          request.resource.data.get('choferPreferidoTelefono', '') ==
              resource.data.get('choferPreferidoTelefono', '')
        );
        allow delete: if isAdmin() || esEncargadoCorporativo(empresaId);
      }

      match /historial/{histId} {
        allow read, create: if isAdmin() || esEncargadoCorporativo(empresaId);
        allow update, delete: if isAdmin();
      }

      match /liquidaciones/{liqId} {
        allow read: if isAdmin() || esEncargadoCorporativo(empresaId);
        allow write: if false;
      }

      // Bauches / pagos reportados por el encargado (escritura solo Cloud Functions).
      match /pagos_reportados/{pagoId} {
        allow read: if isAdmin() || esEncargadoCorporativo(empresaId);
        allow write: if false;
      }

      match /notificaciones_historial/{notifId} {
        allow read: if isAdmin() || esEncargadoCorporativo(empresaId);
        allow write: if false;
      }
    }

    match /corporativo_feriados/{yearId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
