<?xml version="1.0" encoding="utf-8"?>
<!-- Play unificada (com.flygo.rd2): cliente + taxista. Permisos de ubicación en
     segundo plano vienen del manifest principal (taxista en viaje). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission
        android:name="com.google.android.gms.permission.AD_ID"
        tools:node="merge" />

    <application>
        <activity
            android:name=".MainActivity"
            tools:node="merge">
            <!-- Giras/pool: RAI Driver unificado (com.flygo.rd2) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="raidriver"
                    android:host="pool" />
            </intent-filter>
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="flygo-rd.web.app"
                    android:pathPrefix="/pool" />
            </intent-filter>
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="flygo-rd.firebaseapp.com"
                    android:pathPrefix="/pool" />
            </intent-filter>
            <!-- Retorno pago AZUL → app -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="raidriver"
                    android:host="azul"
                    android:pathPrefix="/resultado" />
            </intent-filter>
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="flygo-rd.web.app"
                    android:pathPrefix="/azul/resultado" />
            </intent-filter>
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="flygo-rd.firebaseapp.com"
                    android:pathPrefix="/azul/resultado" />
            </intent-filter>
        </activity>
    </application>
</manifest>
