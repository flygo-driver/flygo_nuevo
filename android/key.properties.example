# Copia a android/key.properties (NO subir al repo).
# Usa tu keystore EXISTENTE de Play — no generes uno nuevo.
#
# Play unificado (com.flygo.rd2):
#   flutter build appbundle --flavor cliente --release
#
# Split futuro conductor (com.flygo.rd2.conductor):
#   flutter build appbundle --flavor conductor --release
#
# storeFile: ruta absoluta o relativa a android/
# Ejemplo candidato: C:/Users/pablo/flygo_rd2/flygo_rd2_keystore.jks
storePassword=
keyPassword=
keyAlias=
storeFile=
